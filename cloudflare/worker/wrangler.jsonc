{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skill-native-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "vars": {
    "SANDBOX_TRANSPORT": "websocket"
  },
  "containers": [
    {
      "class_name": "SkillSandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {"name": "Sandbox", "class_name": "SkillSandbox"},
      {"name": "Telemetry", "class_name": "Telemetry"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["SkillSandbox", "Telemetry"]}
  ]
}
